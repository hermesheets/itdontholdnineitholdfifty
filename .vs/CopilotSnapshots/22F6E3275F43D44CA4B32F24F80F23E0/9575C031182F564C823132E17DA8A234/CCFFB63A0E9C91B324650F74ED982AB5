    public static bool TryTranslate(string? englishWord, out string russianTranslation)
    {
        var normalizedWord = englishWord?.Trim();
        if (!string.IsNullOrEmpty(normalizedWord) && Translations.TryGetValue(normalizedWord, out var translation))
        {
            russianTranslation = translation;
            return true;
        }

        russianTranslation = string.Empty;
        return false;
    }
}
