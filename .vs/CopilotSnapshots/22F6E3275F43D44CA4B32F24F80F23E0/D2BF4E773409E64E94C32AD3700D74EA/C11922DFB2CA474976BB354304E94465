<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:itdontholdnineitholdfifty.ViewModels"
        xmlns:models="using:itdontholdnineitholdfifty.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="900"
        x:Class="itdontholdnineitholdfifty.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Word Steps — Russian"
        Width="1120" Height="900"
        MinWidth="850" MinHeight="650"
        Background="#FFF7F2">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD9785F" />
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#FFFFE8E0" />
        <SolidColorBrush x:Key="InkBrush" Color="#FF382F35" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF81747B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFB94D55" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Spacing="22">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Word Steps" FontSize="34" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Grid.Row="1" Text="Little words for everyday conversations" FontSize="16" Foreground="{StaticResource MutedBrush}" />
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{StaticResource SoftAccentBrush}" CornerRadius="18" Padding="18,12" VerticalAlignment="Center">
                    <TextBlock Text="ENGLISH  →  РУССКИЙ" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="YOUR WORDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="{Binding WordCount}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="saved" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="QUIZ PROGRESS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding ScoreSummary}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ACCURACY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding AccuracyText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="24">
                <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="30">
                    <StackPanel Grid.Column="0" Spacing="14">
                        <TextBlock Text="PRACTICE CARD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding CurrentCard.Word}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding CurrentCard.ExampleSentence}" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <Border Background="{StaticResource SoftAccentBrush}" CornerRadius="12" Padding="14">
                            <TextBlock Text="{Binding AnswerText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Show / hide answer" Command="{Binding ToggleAnswerCommand}" Background="{StaticResource SoftAccentBrush}" Foreground="{StaticResource InkBrush}" Padding="14,9" />
                            <Button Content="Next word" Command="{Binding NextCardCommand}" Background="{StaticResource AccentBrush}" Foreground="White" Padding="16,9" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Quick quiz" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Type the Russian translation, then check your answer." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding QuizAnswer, Mode=TwoWay}" Watermark="Russian translation" />
                        <Button Content="Check answer" Command="{Binding SubmitQuizAnswerCommand}" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Padding="18,9" />
                        <TextBlock Text="{Binding QuizFeedback}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Word library" FontSize="23" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search English, Russian, or category" />
                    <ListBox ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord, Mode=TwoWay}" MaxHeight="430">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:VocabularyWord">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,7">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Text="{Binding Word}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Translation}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="20">
                        <StackPanel Spacing="11">
                            <TextBlock Text="Add a word" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Translate common words offline or enter your own Russian translation." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding NewWord, Mode=TwoWay}" Watermark="English word or phrase" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding NewTranslation, Mode=TwoWay}" Watermark="Russian translation" HorizontalAlignment="Stretch" />
                                <Button Content="Translate" Command="{Binding TranslateNewWordCommand}" Background="{StaticResource SoftAccentBrush}" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <TextBox Text="{Binding NewExample, Mode=TwoWay}" Watermark="Example sentence (optional)" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                            <Button Content="Save to library" Command="{Binding AddWordCommand}" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left" Padding="16,9" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="20">
                        <StackPanel Spacing="11">
                            <TextBlock Text="Edit selected word" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBox Text="{Binding EditWord, Mode=TwoWay}" Watermark="Select a word from the library" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding EditTranslation, Mode=TwoWay}" Watermark="Russian translation" HorizontalAlignment="Stretch" />
                                <Button Content="Translate" Command="{Binding TranslateEditWordCommand}" Background="{StaticResource SoftAccentBrush}" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <TextBox Text="{Binding EditExample, Mode=TwoWay}" Watermark="Example sentence" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save changes" Command="{Binding SaveSelectedWordCommand}" Background="{StaticResource AccentBrush}" Foreground="White" Padding="14,9" />
                                <Button Content="Remove word" Command="{Binding DeleteSelectedWordCommand}" Background="#FFFFE9E9" Foreground="{StaticResource DangerBrush}" Padding="14,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource SoftAccentBrush}" CornerRadius="12" Padding="14">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
