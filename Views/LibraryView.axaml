<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:itdontholdnineitholdfifty.ViewModels"
             xmlns:models="using:itdontholdnineitholdfifty.Models"
             x:Class="itdontholdnineitholdfifty.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="16" Margin="4,8,12,12">
        <Border Background="White" CornerRadius="18" Padding="18">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <StackPanel Spacing="5"><TextBlock Text="Your vocabulary" FontSize="23" FontWeight="Bold" Foreground="#FF26314D" /><TextBlock Text="Browse, filter, and maintain your collection." Foreground="#FF77829A" /></StackPanel>
                <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search words, translations, or categories" Padding="12" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VocabularyWord">
                            <Border Background="#FFF5F6F9" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4"><TextBlock Text="{Binding Word}" FontSize="17" FontWeight="Bold" Foreground="#FF26314D" /><TextBlock Text="{Binding Translation}" Foreground="#FF578875" /><TextBlock Text="{Binding Category}" FontSize="11" Foreground="#FF8992A6" /></StackPanel>
                                    <TextBlock Grid.Column="1" Text="›" FontSize="25" Foreground="#FF98A1B3" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Background="#FFE4F3EC" CornerRadius="18" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Add a word" FontSize="20" FontWeight="Bold" Foreground="#FF26314D" />
                        <TextBox Text="{Binding NewWord, Mode=TwoWay}" Watermark="English word" Padding="11" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewTranslation, Mode=TwoWay}" Watermark="Russian translation" Padding="11" /><Button Grid.Column="1" Content="Translate" Command="{Binding TranslateNewWordCommand}" Padding="12,6" /></Grid>
                        <TextBox Text="{Binding NewExample, Mode=TwoWay}" Watermark="Example sentence (optional)" Padding="11" />
                        <Button Content="Add to library" Command="{Binding AddWordCommand}" HorizontalAlignment="Left" Background="#FF2F8C73" Foreground="White" Padding="18,10" CornerRadius="10" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="18" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Edit selection" FontSize="20" FontWeight="Bold" Foreground="#FF26314D" />
                        <TextBox Text="{Binding EditWord, Mode=TwoWay}" Watermark="English word" Padding="11" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding EditTranslation, Mode=TwoWay}" Watermark="Russian translation" Padding="11" /><Button Grid.Column="1" Content="Translate" Command="{Binding TranslateEditWordCommand}" Padding="12,6" /></Grid>
                        <TextBox Text="{Binding EditExample, Mode=TwoWay}" Watermark="Example sentence" Padding="11" />
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save changes" Command="{Binding SaveSelectedWordCommand}" Background="#FF26314D" Foreground="White" Padding="16,9" CornerRadius="10" /><Button Content="Delete" Command="{Binding DeleteSelectedWordCommand}" Padding="16,9" CornerRadius="10" /></StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FF557E70" TextWrapping="Wrap" Margin="4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
